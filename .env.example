# Copy to .env and adjust as needed. docker compose reads .env automatically.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
ODOO_PORT=8069
ODOO_LONGPOLL_PORT=8072
# Database created by scripts/init.sh
ODOO_DB=thoughtocean
# Company set up by scripts/init.sh on first run (country drives the chart of accounts/currency)
ODOO_COMPANY="Maan's Pizza Shop"
ODOO_COUNTRY=AU

# Production only (see deploy/): public hostname for HTTPS, and the compose
# files to use. deploy/server-setup.sh fills these in on the server.
DOMAIN=
#COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.prod.yml
