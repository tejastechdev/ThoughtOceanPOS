<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_uber_eats" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.uber.eats</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='session_id']" position="after">
                <field name="uber_eats_order_ids" widget="many2many_tags" invisible="not uber_eats_order_ids"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_filter_uber_eats" model="ir.ui.view">
        <field name="name">pos.order.search.inherit.uber.eats</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='invoiced']" position="after">
                <filter name="uber_eats" string="Uber Eats" domain="[('is_uber_eats', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
